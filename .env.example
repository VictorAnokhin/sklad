APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Footer (pages with home layout): optional override; counts from DB (project, users)
# FOOTER_COMPANY_NAME=
# FOOTER_PLATFORM_URL=https://autoagent.in.ua
# FOOTER_PLATFORM_LABEL=autoagent.in.ua
# FOOTER_BANK_URL=https://app.autoagent.in.ua
# FOOTER_BANK_LABEL=app.autoagent.in.ua

# CDN / Media Configuration
# MEDIA_ASSET_URL: URL до сховища файлів (файли у storage/app/public)
#   Development: http://localhost:8000
#   Production:  https://example.com або https://cdn.example.com
# MEDIA_IMAGE_URL: URL до зовнішнього CDN для заблочених фото
#   Зазвичай: https://sklad.autoagent.in.ua
MEDIA_ASSET_URL=http://localhost:8000
MEDIA_IMAGE_URL=https://sklad.autoagent.in.ua

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# Local development: MAIL_HOST=mailpit, MAIL_PORT=1025, MAIL_ENCRYPTION=null
# Production example: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Comma-separated origins for SPA (production only). Example: https://app.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=

# Google Identity Services Web client id
GOOGLE_CLIENT_ID=257444416119-nk4t6eq0aeh31c1ho18e6huivutthrgp.apps.googleusercontent.com
SUI_ZKLOGIN_PROVER_URL=https://prover-dev.mystenlabs.com/v1
# Shinami: https://docs.shinami.com (wallet/zkProver key for proof, gas key only for sponsorship; keys only on server).
SHINAMI_API_BASE=https://api.us1.shinami.com
SHINAMI_WALLET_ACCESS_KEY=
# Optional aliases accepted by config/services.php when SHINAMI_WALLET_ACCESS_KEY is empty:
# SHINAMI_ZKPROVER_ACCESS_KEY=
# SHINAMI_ACCESS_KEY=
# SHINAMI_API_KEY=
SHINAMI_GAS_ACCESS_KEY=

# Atoma AI assistant (server-side only; never expose this key in Vite/browser env)
ATOMA_API_BASE=https://api.atoma.network
ATOMA_API_KEY=
ATOMA_MODEL=openai/gpt-4o-mini
ATOMA_TIMEOUT=60

# OpenAI AI assistant (server-side only; never expose this key in Vite/browser env)
OPENAI_API_BASE=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT=60

# DeepSeek AI assistant (server-side only)
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60

# ManagerAI bridge for webchat delegation
MANAGER_AI_ENABLED=false
MANAGER_AI_URL=https://ai.autoagent.in.ua
MANAGER_AI_FORWARDED_HOST=ai.autoagent.in.ua
# Company UUID from ManagerAI company settings/panel.
MANAGER_AI_COMPANY_ID=
MANAGER_AI_BRIDGE_SECRET=
MANAGER_AI_TIMEOUT=15
MANAGER_AI_FALLBACK_TO_LOCAL=true

# ──────────────────────────────────────────────
#  AI Provider & Channel Configuration
#  Подробнее: config/ai.php
# ──────────────────────────────────────────────
# AI_DEFAULT_PROVIDER — провайдер по умолчанию (deepseek|openai|atoma)
AI_DEFAULT_PROVIDER=deepseek

# Провайдер для Telegram-канала (если отличается от default)
# AI_TELEGRAM_PROVIDER=deepseek
# AI_TELEGRAM_MODEL=deepseek-chat
# AI_TELEGRAM_TEMPERATURE=0.3
# AI_TELEGRAM_MAX_TOKENS=2000

# Провайдер для веб-чата (если отличается от default)
# AI_WEB_CHAT_PROVIDER=deepseek
# AI_WEB_CHAT_MODEL=deepseek-chat
# AI_WEB_CHAT_TEMPERATURE=0.7
# AI_WEB_CHAT_MAX_TOKENS=700

# Провайдер для агентов (если отличается от default)
# AI_AGENT_PROVIDER=deepseek
# AI_AGENT_MODEL=deepseek-chat
# AI_AGENT_TEMPERATURE=0.3
# AI_AGENT_MAX_TOKENS=2000

# Максимальное количество итераций tool calling
# AI_TOOLS_MAX_ITERATIONS=10

# Local gas sponsor: set both vars. Overrides Shinami when set. Details in laravel-api/GAS_SPONSOR.md
SUI_RPC_URL=
SUI_GAS_SPONSOR_PRIVATE_KEY=

# AV8 Capital Move package (same as VITE_SUI_PACKAGE_ID in av8fund-react)
AV8_CAPITAL_PACKAGE_ID=
AV8_CAPITAL_POOL_REGISTRY_ID=
AV8_CAPITAL_POOL_ADMIN_CAP_ID=

# Walrus publisher proxy for RWA media uploads. Keep mainnet publisher credentials/server URLs on Laravel only.
WALRUS_TESTNET_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_MAINNET_PUBLISHER_URL=
WALRUS_HTTP_TIMEOUT=120
WALRUS_MAX_UPLOAD_BYTES=26214400

# Sumsub KYC / AML. Keep token and secret server-side only.
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=sbx:wIU72ab9lwrFHQKMlxVFMBcG.dgWTlSxvHLkfJDJS6YSmSE9tH4VIRZpt
SUMSUB_SECRET_KEY=80EousMPb6kUtkWOiaagZtgpxzLSWyJ4
SUMSUB_LEVEL_NAME=basic-kyc-level
SUMSUB_TOKEN_TTL=600

