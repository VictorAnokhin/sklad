COINGECKO_API_KEY=CG-6GGWkSxT6uCxNLVzodFRtUhW

# Chainalysis KYT — AML screening for incoming USDT (server-side only)
CHAINALYSIS_ENABLED=true
CHAINALYSIS_API_KEY=
CHAINALYSIS_API_BASE_URL=https://api.chainalysis.com/api/kyt/v2
CHAINALYSIS_MOCK_MODE=true
CHAINALYSIS_FAIL_OPEN=false
CHAINALYSIS_CACHE_MINUTES=15
CHAINALYSIS_PLATFORM_DEPOSIT_ADDRESS=
CHAINALYSIS_BLOCKED_RISK_LEVELS=HIGH,SEVERE,CRITICAL
